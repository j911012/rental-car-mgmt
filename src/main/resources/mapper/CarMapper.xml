<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.rental.mapper.CarMapper">

    <select id="search" resultType="com.example.rental.entity.Car">
        SELECT
            car_id,
            car_name,
            number_plate,
            status,
            created_at,
            updated_at
        FROM car
        <where>
            <if test="carName != null and carName != ''">
                AND car_name LIKE CONCAT('%', #{carName}, '%')
            </if>
            <if test="status != null">
                AND status = #{status}
            </if>
        </where>
        ORDER BY car_id
    </select>

</mapper>
